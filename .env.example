# SENTIO AI 환경 변수 설정
# 이 파일을 복사하여 .env로 이름 변경 후 사용하세요

# === 프로덕션 체크리스트 ===
# [ ] DEBUG=false 설정
# [ ] DEV_AUTO_LOGIN=false 설정  
# [ ] JWT_SECRET_KEY 강력한 난수로 변경
# [ ] COOKIE_SECURE=true 설정 (HTTPS 필수)
# [ ] DATABASE_URL PostgreSQL로 변경
# [ ] VAPID 키 생성 (scripts/generate_secrets.py)

# === 서버 설정 ===
HOST=0.0.0.0
PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# === 카메라 설정 ===
CAMERA_INDEX=0
# RTSP URL 또는 파일 경로 (빈 문자열이면 CAMERA_INDEX 사용)
CAMERA_SOURCE=

# === 데이터베이스 ===
DATABASE_URL=sqlite+aiosqlite:///./sentio.db

# === 프론트엔드 URL (CORS 허용) ===
FRONTEND_URL=http://localhost:5173
# 추가 CORS 허용 출처 (쉼표로 구분)
CORS_ALLOWED_ORIGINS=

# === JWT 인증 ===
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# === 쿠키 보안 설정 ===
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# === 내부 서비스 통신 키 ===
# Docker 환경에서 go2rtc 등 내부 서비스의 MJPEG 스트림 접근 인증
# 로컬 개발 시 비어있으면 내부 스트림 엔드포인트 비활성화
INTERNAL_STREAM_KEY=

# === FHIR EMR 연동 (선택) ===
# 비어있으면 비활성화
FHIR_BASE_URL=
FHIR_API_KEY=

# === 푸시 알림 (VAPID) ===
# 비어있으면 푸시 알림 비활성화
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=

# === IoT 디바이스 연동 (선택) ===
# 경광등 등 외부 IoT 디바이스 Webhook URL
# 비어있으면 비활성화
IOT_WEBHOOK_URL=
IOT_WEBHOOK_SECRET=

# === 개발 모드 설정 ===
DEV_AUTO_LOGIN=false
DEV_AUTO_LOGIN_USERNAME=admin

# === 데모 모드 ===
DEMO_VIDEO_DIR=demo_videos

# === 성능 최적화 ===
OVERLAY_ENABLED=false
YOLO_USE_GPU=true

# === 다중 카메라 ===
MULTI_CAMERA_ENABLED=false

# === 낙상 감지 설정 ===
FALL_WARNING_SECONDS=1.5
FALL_DANGER_SECONDS=5.0
FALL_COOLDOWN_SECONDS=3.0
FALL_HEAD_HIP_THRESHOLD=0.05
